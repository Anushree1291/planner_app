# Copy to .env for local development. Never commit .env.
# Everything is optional locally; defaults use a SQLite file.

# APP_ENV=production             # enables secure cookies; requires SECRET_KEY + CRON_SECRET
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/plannerdb?sslmode=require
# SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# CRON_SECRET=another-long-random-string
# PUBLIC_URL=https://your-app.azurewebsites.net

# ---- AI goal breakdown (optional; configure one or both) ----
# Order to try providers in; the second is a backup if the first fails.
# AI_PROVIDER=azure,gemini

# Azure AI Foundry: any deployed chat model (gpt-4o-mini, gpt-5-mini, DeepSeek-V3, Llama, Phi...)
# AZURE_AI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_AI_API_KEY=<key from the Foundry portal>
# AZURE_AI_DEPLOYMENT=<your deployment name, e.g. gpt-4o-mini>

# Google Gemini: free key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=<your key>
# GEMINI_MODEL=gemini-flash-latest

# AI_DAILY_LIMIT_PER_USER=3
# AI_DAILY_LIMIT_PER_GUEST=1
# AI_DAILY_LIMIT_GLOBAL=100

# Book lookups use Google Books and Open Library, free with no key. A Google Books key
# (console.cloud.google.com -> Books API) only raises the rate limit.
# GOOGLE_BOOKS_API_KEY=

# ---- Email (optional; locally, emails are printed to the console) ----
# Azure Communication Services, from a no-reply address (see docs/EMAIL_AZURE.md)
# ACS_CONNECTION_STRING=endpoint=https://<name>.communication.azure.com/;accesskey=...
# EMAIL_FROM=noreply@mail.yourdomain.com
# Your Azure sending limits: 5/10 for an azurecomm.net address, 30/100 for a new custom domain,
# or whatever Microsoft approves. The scheduler never goes over them.
# EMAIL_RATE_PER_MINUTE=30
# EMAIL_RATE_PER_HOUR=100
# EMAIL_CONCURRENCY=4
# EMAIL_EVENTS_KEY=<random key for the Event Grid bounce webhook>
# Alternatively, any SMTP server:
# SMTP_HOST=  SMTP_PORT=587  SMTP_USERNAME=  SMTP_PASSWORD=

# ENABLE_LOCAL_SCHEDULER=true    # default true locally, false in production
