# Copy to .env for local development. Never commit .env.
# Everything is optional locally; defaults use a SQLite file.

# APP_ENV=production             # enables secure cookies; requires SECRET_KEY + CRON_SECRET
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/plannerdb?sslmode=require
# SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# CRON_SECRET=another-long-random-string
# PUBLIC_URL=https://your-app.azurewebsites.net

# AI goal breakdown (optional)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# AI_DAILY_LIMIT_PER_USER=3
# AI_DAILY_LIMIT_PER_GUEST=1
# AI_DAILY_LIMIT_GLOBAL=100

# ENABLE_LOCAL_SCHEDULER=true    # default true locally, false in production
